[
	(
		regex: r#"^\$argon2id\$v=19\$m=[1-9]\d*,t=[1-9]\d*,p=[1-9]\d*\$[A-Za-z0-9+/]{11,}\$[A-Za-z0-9+/]{16,}$"#,
		modes: [
			(
				name: "Argon2id",
			)
		]
	),
	(
		regex: r#"^\$argon2i\$v=19\$m=[1-9]\d*,t=[1-9]\d*,p=[1-9]\d*\$[A-Za-z0-9+/]{11,}\$[A-Za-z0-9+/]{16,}$"#,
		modes: [
			(
				name: "Argon2i",
			)
		]
	),
	(
		regex: r#"^\$argon2d\$v=19\$m=[1-9]\d*,t=[1-9]\d*,p=[1-9]\d*\$[A-Za-z0-9+/]{11,}\$[A-Za-z0-9+/]{16,}$"#,
		modes: [
			(
				name: "Argon2d",
			)
		]
	),
	(
		regex: r#"^\$2[abyx]\$[0-9]{2}\$[A-Za-z0-9./]{53}$"#,
		modes: [
			(
				name: "Bcrypt",
			)
		]
	),
	(
		regex: r#"^[0-9a-fA-F]{128}$"#,
		modes: [
			(
				name: "SHA-512",
			),
			(
				name: "SHA3-512",
			),
			(
				name: "BLAKE2b-512",
			),
			(
				name: "Whirlpool",
			),
			(
				name: "Streebog-512",
			),
			(
				name: "MD6",
			),
		]
	),
	(
		regex: r#"^\$6\$(?:rounds=[1-9]\d*\$)?[A-Za-z0-9./]{1,16}\$[A-Za-z0-9./]{86}$"#,
		modes: [
			(
				name: "SHA-512 Crypt",
			)
		]
	),
	(
		regex: r#"^[0-9a-fA-F]{64}$"#,
		modes: [
			(
				name: "SHA-256",
			),
			(
				name: "SHA3-256",
			),
			(
				name: "BLAKE2b-256",
			),
			(
				name: "BLAKE2s-256",
			),
			(
				name: "RIPEMD-256",
			),
			(
				name: "Streebog-256",
			),
			(
				name: "Fletcher-64",
			),
		]
	),
	(
		regex: r#"^\$5\$(?:rounds=[1-9]\d*\$)?[A-Za-z0-9./]{1,16}\$[A-Za-z0-9./]{43}$"#,
		modes: [
			(
				name: "SHA-256 Crypt",
			)
		]
	),
	(
		regex: r#"^[0-9a-fA-F]{32}$"#,
		modes: [
			(
				name: "MD5",
			),
			(
				name: "MD4",
			),
			(
				name: "NTLM",
			),
			(
				name: "BLAKE2b-128",
			),
			(
				name: "RIPEMD-128",
			),
			(
				name: "LM",
			),
			(
				name: "BLAKE2s-128",
			),
			(
				name: "MD2",
			),
		]
	),
	(
		regex: r#"^\$1\$[A-Za-z0-9./]{1,8}\$[A-Za-z0-9./]{22}$"#,
		modes: [
			(
				name: "MD5 Crypt",
			)
		]
	),
	(
		regex: r#"^[A-Za-z0-9./]{13}$"#,
		modes: [
			(
				name: "DES Crypt",
			)
		]
	),
	(
		regex: r#"^[0-9a-fA-F]{43}$"#,
		modes: [
			(
				name: "SHA-1",
			)
		]
	),
		(
		regex: r#"^[0-9a-fA-F]{96}$"#,
		modes: [
			(
				name: "SHA-384",
			),
			(
				name: "SHA3-384",
			),
			(
				name: "BLAKE2b-384",
			),
		]
	),
	(
		regex: r#"^[0-9a-fA-F]{56}$"#,
		modes: [
			(
				name: "SHA-224",
			),
			(
				name: "SHA3-224",
			),
		]
	),
	(
		regex: r#"^[0-9a-fA-F]{40}$"#,
		modes: [
			(
				name: "BLAKE2b-160",
			),
			(
				name: "RIPEMD-160",
			),
			(
				name: "BLAKE2s-160",
			),
		]
	),
	(
		regex: r#"^[0-9a-fA-F]{80}$"#,
		modes: [
			(
				name: "RIPEMD-320",
			),
		]
	),
	(
		regex: r#"^[0-9a-fA-F]{8}$"#,
		modes: [
			(
				name: "Adler-32",
			),
			(
				name: "Fletcher-32",
			),
		]
	),
]